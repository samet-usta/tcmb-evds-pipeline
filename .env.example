# EVDS (TCMB)
EVDS_API_KEY=your_evds_api_key
EVDS_BASE_URL=https://evds3.tcmb.gov.tr/igmevdsms-dis/

# Frankfurter (fallback, FX only)
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v2

# AWS S3 (LocalStack)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=eu-central-1
AWS_ENDPOINT_URL_S3=http://localstack:4566
S3_BUCKET=tcmb-evds-landing

# Warehouse (PostgreSQL)
WAREHOUSE_HOST=warehouse
WAREHOUSE_PORT=5432
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=usr_warehouse
WAREHOUSE_PASSWORD=change_me

# Airflow
AIRFLOW_UID=50000

# LocalStack (Hobby tier auth token)
LOCALSTACK_AUTH_TOKEN=your_localstack_auth_token

# Airflow metadata DB (PostgreSQL)
AIRFLOW_DB_USER=usr_airflow
AIRFLOW_DB_PASSWORD=change_me
AIRFLOW_DB_NAME=airflow

# Airflow UI admin user
AIRFLOW_ADMIN_USER=usr_airflow_admin
AIRFLOW_ADMIN_PASSWORD=change_me

# Airflow secrets (generate your own values)
AIRFLOW_FERNET_KEY=your_fernet_key
AIRFLOW_JWT_SECRET=your_jwt_secret
AIRFLOW_API_SECRET_KEY=your_api_secret_key
